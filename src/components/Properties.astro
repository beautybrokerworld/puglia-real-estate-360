---
import Layout from '../layouts/Layout.astro';
import {properties,propertyRoute,routes,type Lang} from '../data/properties';
const {lang='it'}=Astro.props as {lang:Lang};
const it=lang==='it';
---
<Layout lang={lang} page="properties" title={it?'Le nostre soluzioni immobiliari':'Our holiday properties'} description={it?'Scopri le case vacanza tra Lecce, Otranto e Galugnano. La selezione si amplia nel tempo: scegli una soluzione e chiedi disponibilità.':'Discover holiday homes in Lecce, Otranto and Galugnano. Our collection will grow over time. Choose a property and enquire about availability.'}>
  <section class="section property-section property-catalogue" id="selezione" aria-labelledby="catalogue-heading">
    <div class="wrap">
      <header class="catalogue-intro" data-enter>
        <h1 id="catalogue-heading">{it?'Le nostre case nel Salento.':'Our homes in Salento.'}</h1>
        <p>{it?'Una selezione in crescita tra mare, campagna e città. Trova il tuo soggiorno.':'A growing collection by the sea, in the country and in town. Find your stay.'}</p>
      </header>
      <div class="grid property-grid">{properties.map((p,index)=><article class="card card--open property-card span-4" id={p.id}>
        <div class="property-photo frame frame--photo"><img src={p.cover.src} srcset={p.cover.srcset} sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc((100vw - 144px) / 3), calc((100vw - 208px) / 3)" alt={p.cover.alt[lang]} style={{objectPosition:p.coverPosition}} loading={index<3?'eager':'lazy'} width={p.cover.width} height={p.cover.height} data-source="client" data-subject={p.title.en}/></div>
        <div class="property-content"><div class="property-meta"><span>{p.place}</span></div><h2><a class="property-card-title" href={propertyRoute(lang,p.id)}>{p.title[lang]}</a></h2><p>{p.detail[lang]}</p><div class="property-bottom"><span>{p.feature[lang]}</span><a class="link" href={`${routes[lang].properties}?property=${p.id}#contatti`}>{it?'Richiedi disponibilità':'Enquire about this home'}</a></div></div>
      </article>)}</div>
    </div>
  </section>
  <section class="section assistance-section" id="soggiorno" aria-labelledby="stay-h">
    <div class="wrap">
      <div class="assistance-grid">
        <div class="assistance-copy">
          <h2 id="stay-h">{it?'Il soggiorno comincia da qui.':'Your stay starts here.'}</h2>
          <p class="t-lead">{it?'Hai trovato la casa che ti interessa? Nel modulo puoi indicare la soluzione e raccontarci il tuo viaggio.':'Found a home you like? Select the property in the form and tell us about your trip.'}</p>
          <p>{it?'Aggiungi le date indicative e il numero di ospiti: ci aiuteranno a rispondere alla tua richiesta.':'Include your approximate dates and number of guests so we can answer your enquiry.'}</p>
          <a class="btn btn--primary" href="#contatti">{it?'Scrivi la tua richiesta':'Write your enquiry'}<span aria-hidden="true">↗</span></a>
        </div>
        <figure class="assistance-photo frame frame--photo" data-moment="picture-develops">
          <img class="frame__img" src="/images/properties/tramontana/06-2693d269f6b14ef1a22a803b77d09358.webp" srcset="/images/properties/tramontana/06-2693d269f6b14ef1a22a803b77d09358-700.webp 700w, /images/properties/tramontana/06-2693d269f6b14ef1a22a803b77d09358.webp 1280w" sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc((100vw - 120px) / 2), calc((100vw - 184px) / 2)" alt={it?'Il mare di Otranto visto dal balcone, con un veliero in miniatura in primo piano':'The sea at Otranto from the balcony, with a model sailing ship in the foreground'} loading="lazy" width="1280" height="1600" data-source="client" data-subject="Otranto sea view"/>
        </figure>
      </div>
    </div>
  </section>
</Layout>
