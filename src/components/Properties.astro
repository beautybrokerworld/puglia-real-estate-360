---
import Layout from '../layouts/Layout.astro';
import {properties,type Lang} from '../data/properties';
const {lang='it'}=Astro.props as {lang:Lang};const it=lang==='it';
---
<Layout lang={lang} page="properties" title={it?'Le nostre soluzioni immobiliari':'Our holiday properties'} description={it?'Sei case vacanza a Lecce, Otranto e Galugnano: giardino, mare, piscina e terrazzi. Scegli una soluzione e richiedi disponibilità.':'Six holiday homes in Lecce, Otranto and Galugnano, with gardens, sea views, a pool and terraces. Choose a property and enquire about availability.'}>
  <section class="hero hero--editorial-custom editorial-hero catalogue-hero" data-enter aria-labelledby="hero-h"><div class="wrap"><div class="hero-text hero__in"><div class="hero__head"><div><h1 id="hero-h">{it?'Le nostre case in Salento.':'Our homes in Salento.'}</h1><p class="hero__lead">{it?'Sei soluzioni. Trova quella per la tua vacanza.':'Six properties. Find a home for your holiday.'}</p></div><div class="btn-row"><a class="btn btn--primary" href="#selezione">{it?'Guarda le sei soluzioni':'View the six properties'}<span aria-hidden="true">↓</span></a></div></div><div class="hero__stage frame frame--photo"><img src="/images/terrazza-hero.webp" srcset="/images/terrazza-hero-700.webp 700w, /images/terrazza-hero.webp 1050w" sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc(100vw - 96px), calc(100vw - 160px)" alt={it?'Pergola e piante sul terrazzo della villetta a Lecce':'Pergola and plants on the terrace of the villa in Lecce'} width="1050" height="1400" fetchpriority="high" data-source="client" data-subject="Terrace Lecce"/></div></div></div></section>
  {[properties.slice(0,3),properties.slice(3,6)].map((group,i)=><section class="section property-section" id={i===0?'selezione':'altre-case'} aria-labelledby={`selection-${i}`} style="--hm:2"><div class="wrap"><h2 id={`selection-${i}`}>{i===0?(it?'Giardino, mare o piscina.':'Garden, sea or pool.'):(it?'Terrazzi e case di paese.':'Terraces and town homes.')}</h2><div class="grid property-grid">{group.map((p,index)=><article class="card card--open property-card span-4" id={p.id}><a class="property-photo frame frame--photo" href="#contatti" data-property-link={p.id} aria-label={`${it?'Richiedi disponibilità per':'Enquire about'} ${p.title[lang]}`}><img src={`/images/${p.image}-700.webp`} alt={p.alt[lang]} loading="lazy" width="1050" height="1400" data-source="client" data-subject={p.title.en}/></a><div class="property-content"><div class="property-meta"><span>{p.place}</span></div><h3>{p.title[lang]}</h3><p>{p.detail[lang]}</p><div class="property-bottom"><span>{p.feature[lang]}</span><a class="link" href="#contatti" data-property-link={p.id}>{it?'Richiedi disponibilità':'Enquire about this home'}</a></div></div></article>)}</div></div></section>)}
  <section class="section assistance-section" id="soggiorno" aria-labelledby="stay-h"><div class="wrap"><h2 id="stay-h">{it?'Il soggiorno comincia da qui.':'Your stay starts here.'}</h2><div class="grid about-grid"><div class="span-6 about-copy"><p class="t-lead">{it?'Hai trovato la casa che ti interessa? Nel modulo puoi indicare la soluzione e raccontarci il tuo viaggio.':'Found a home you like? Select the property in the form and tell us about your trip.'}</p><p>{it?'Aggiungi le date indicative e il numero di ospiti: ci aiuteranno a rispondere alla tua richiesta.':'Include your approximate dates and number of guests so we can answer your enquiry.'}</p><a class="btn btn--primary" href="#contatti">{it?'Scrivi la tua richiesta':'Write your enquiry'}<span aria-hidden="true">↗</span></a></div><figure class="develop frame frame--photo span-6 start-7" data-moment="picture-develops"><img src="/images/giardino-dettaglio.webp" srcset="/images/giardino-dettaglio-700.webp 700w, /images/giardino-dettaglio.webp 1050w" sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc((100vw - 120px) / 2), calc((100vw - 184px) / 2)" alt={it?'Camera della villetta con giardino a Lecce':'Bedroom in the villa with a garden in Lecce'} loading="lazy" width="1050" height="1400" data-source="client" data-subject="Lecce villa bedroom"/></figure></div></div></section>
</Layout>
