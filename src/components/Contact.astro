---
import {properties, routes, type Lang} from '../data/properties';
import {business} from '../data/business';
const {lang='it', propertyId} = Astro.props as {lang:Lang, propertyId?:string};
const it=lang==='it';
---
<div class="closing__cta contact-grid">
  <div class="contact-copy">
    <p class="eyebrow">{it?'La tua prossima vacanza':'Your next holiday'}</p>
    <h2 id="contact-heading">{it?'Parliamo del tuo soggiorno.':'Let’s plan your stay.'}</h2>
    <p class="t-lead">{it?'Raccontaci quando vuoi partire e quale casa ti interessa. Ti risponderemo con disponibilità e informazioni.':'Tell us when you would like to travel and which home you have in mind. We will reply with availability and details.'}</p>
    <div class="contact-details">
      <a class="link" href="mailto:pugliarealestate360@gmail.com">pugliarealestate360@gmail.com</a>
      <a class="link" href="tel:+393202354042">+39 320 235 4042</a>
      <span>{business.address}</span>
    </div>
  </div>
  <form class="form booking-form" action="https://formsubmit.co/pugliarealestate360@gmail.com" method="post"
    data-return-path={it?'/grazie/':'/en/thank-you/'}
    data-fix={it?'Controlla i campi indicati: {n}.':'Please check the marked fields: {n}.'}>
    <input type="hidden" name="_subject" value="Richiesta soggiorno — Puglia Real Estate 360"/>
    <input type="hidden" name="_template" value="table"/>
    <input type="hidden" name="lang" value={lang}/>
    <div class="hp" aria-hidden="true"><label for="website">Website</label><input id="website" name="_honey" autocomplete="off" tabindex="-1"/></div>
    <div class="form-pair">
      <div class="field"><label for="name">{it?'Nome e cognome':'Full name'} <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="100" data-error={it?'Inserisci il tuo nome (almeno 2 caratteri).':'Enter your name (at least 2 characters).'}/></div>
      <div class="field"><label for="email">Email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" data-error={it?'Inserisci un indirizzo email valido.':'Enter a valid email address.'}/></div>
    </div>
    <div class="form-pair">
      <div class="field"><label for="phone">{it?'Telefono (facoltativo)':'Phone (optional)'}</label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40"/></div>
      <div class="field"><label for="property">{it?'La soluzione che ti interessa':'Your preferred property'}</label><select id="property" name="property"><option value="">{it?'Aiutami a scegliere':'Help me choose'}</option>{properties.map(p=><option value={p.id} selected={p.id===propertyId}>{p.title[lang]} — {p.place}</option>)}</select></div>
    </div>
    <div class="field"><label for="message">{it?'Il tuo messaggio':'Your message'} <span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="3" required minlength="10" maxlength="4000" placeholder={it?'Date indicative, numero di ospiti e ciò che cerchi.':'Approximate dates, number of guests and what you are looking for.'} data-error={it?'Scrivi un messaggio di almeno 10 caratteri.':'Write a message of at least 10 characters.'}></textarea></div>
    <div class="field privacy-check"><label for="privacy"><input id="privacy" name="privacy" type="checkbox" value="accepted" required data-error={it?'Conferma di aver letto l’informativa privacy.':'Please confirm you have read the privacy notice.'}/><span>{it?'Ho letto l’':'I have read the '}<a class="link" href={routes[lang].privacy}>{it?'informativa privacy':'privacy notice'}</a>.</span></label></div>
    <button class="btn btn--primary" type="submit">{it?'Invia la richiesta':'Send an enquiry'}<span aria-hidden="true">↗</span></button>
    <p class="form__status" role="status" data-form-status></p>
  </form>
</div>

<script>
// Resolve the return URL in the browser so previews and the final domain both work.
// Without JavaScript, FormSubmit uses its own confirmation page.
document.querySelectorAll<HTMLFormElement>('form[data-return-path]').forEach(form=>{
  const next=document.createElement('input');
  next.type='hidden';next.name='_next';
  next.value=new URL(form.dataset.returnPath!,location.origin).href;
  form.append(next);
});
</script>
