---
import Layout from '../layouts/Layout.astro';
import Services from './Services.astro';
import HeroImage from './HeroImage.astro';
import {routes,type Lang} from '../data/properties';
const {lang='it'}=Astro.props as {lang:Lang};const it=lang==='it';
---
<Layout lang={lang} page="home" title={it?'Case vacanza nel Salento':'Holiday homes in Salento'} description={it?'Scopri le case vacanza tra Lecce, Otranto e Galugnano e chiedi disponibilità a Puglia Real Estate 360.':'Discover holiday homes in Lecce, Otranto and Galugnano and ask Puglia Real Estate 360 for availability.'}>
  <section class="hero hero--editorial-custom editorial-hero" data-enter aria-labelledby="hero-h"><div class="wrap"><div class="hero-text hero__in">
    <div class="hero__head"><div><h1 id="hero-h">{it?'Case vacanza nel Salento.':'Holiday homes in Salento.'}</h1><p class="hero__lead">{it?'Una selezione in crescita tra Lecce, Otranto e Galugnano.':'A growing collection in Lecce, Otranto and Galugnano.'}</p></div><div class="btn-row"><a class="btn btn--primary" href={routes[lang].properties}>{it?'Guarda le nostre case':'View our homes'}<span aria-hidden="true">↗</span></a></div></div>
    <HeroImage lang={lang}/>
  </div></div></section>
  <section class="section about-section" id="le-case" aria-labelledby="homes-h"><div class="wrap">
    <h2 id="homes-h">{it?'Una casa, il tuo Salento.':'A home for your Salento stay.'}</h2>
    <div class="grid about-grid"><div class="span-6 about-copy"><p class="t-lead">{it?'La selezione è in crescita: trovi soggiorni con giardino a Lecce, sul mare a Otranto e con piscina a Galugnano.':'Our collection is growing, with stays in Lecce, by the sea in Otranto and with a pool in Galugnano.'}</p><p>{it?'Altre case si aggiungeranno presto. Scegli la soluzione che ti interessa e scrivici per verificare la disponibilità.':'More homes will be added soon. Choose a property that interests you and ask us about availability.'}</p><a class="btn btn--primary" href={routes[lang].properties}>{it?'Guarda le nostre soluzioni immobiliari':'View our holiday properties'}<span aria-hidden="true">↗</span></a><div class="location-list"><span>Lecce</span><span>Otranto</span><span>Galugnano</span></div></div>
    <figure class="develop frame frame--photo span-6 start-7" data-moment="picture-develops"><img src="/images/lecce-giardino.webp" srcset="/images/lecce-giardino-700.webp 700w, /images/lecce-giardino.webp 1050w" sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc((100vw - 120px) / 2), calc((100vw - 184px) / 2)" alt={it?'Patio della villetta con giardino a Lecce':'Patio of the villa with a garden in Lecce'} width="1050" height="1400" loading="lazy" data-source="client" data-subject="Villa patio Lecce"/></figure></div>
  </div></section>
  <Services lang={lang}/>
</Layout>
