---
import Layout from '../layouts/Layout.astro';
import {routes,type Lang} from '../data/properties';
const {lang='it'}=Astro.props as {lang:Lang};const it=lang==='it';
---
<Layout lang={lang} page="home" title={it?'Case vacanza nel Salento':'Holiday homes in Salento'} description={it?'Sei soluzioni per le tue vacanze tra Lecce, Otranto e Galugnano. Guarda le case e richiedi disponibilità a Puglia Real Estate 360.':'Six holiday homes in Lecce, Otranto and Galugnano. View the properties and ask Puglia Real Estate 360 for availability.'}>
  <section class="hero hero--editorial-custom editorial-hero" data-enter aria-labelledby="hero-h"><div class="wrap"><div class="hero-text hero__in">
    <div class="hero__head"><div><h1 id="hero-h">{it?'Case vacanza nel Salento.':'Holiday homes in Salento.'}</h1><p class="hero__lead">{it?'6 case tra Lecce, Otranto e Galugnano.':'6 homes in Lecce, Otranto and Galugnano.'}</p></div><div class="btn-row"><a class="btn btn--primary" href={routes[lang].properties}>{it?'Guarda le nostre case':'View our homes'}<span aria-hidden="true">↗</span></a></div></div>
    <div class="hero__stage frame frame--photo"><img src="/images/lecce-aria-sana.webp" srcset="/images/lecce-aria-sana-700.webp 700w, /images/lecce-aria-sana.webp 1050w" sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc(100vw - 96px), calc(100vw - 160px)" alt={it?'Terrazzo verde con pergola di una delle case a Lecce':'A green terrace with a pergola at one of our homes in Lecce'} width="1050" height="1400" fetchpriority="high" data-source="client" data-subject="Holiday home terrace in Lecce"/></div>
  </div></div></section>
  <section class="section about-section" id="le-case" aria-labelledby="homes-h"><div class="wrap">
    <h2 id="homes-h">{it?'Una casa, il tuo Salento.':'A home for your Salento stay.'}</h2>
    <div class="grid about-grid"><div class="span-6 about-copy"><p class="t-lead">{it?'Un giardino a Lecce, il mare di Otranto, una piscina a Galugnano. Sei case per la tua vacanza.':'A garden in Lecce, the sea in Otranto, a pool in Galugnano. Six homes for your holiday.'}</p><p>{it?'Scegli la casa e scrivici: ti aiutiamo a verificare la disponibilità e a organizzare il soggiorno.':'Choose a home and write to us. We can help you check availability and arrange your stay.'}</p><a class="btn btn--primary" href={routes[lang].properties}>{it?'Guarda le nostre soluzioni immobiliari':'View our holiday properties'}<span aria-hidden="true">↗</span></a><div class="location-list"><span>Lecce</span><span>Otranto</span><span>Galugnano</span></div></div>
    <figure class="develop frame frame--photo span-6 start-7" data-moment="picture-develops"><img src="/images/lecce-giardino.webp" srcset="/images/lecce-giardino-700.webp 700w, /images/lecce-giardino.webp 1050w" sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc((100vw - 120px) / 2), calc((100vw - 184px) / 2)" alt={it?'Patio della villetta con giardino a Lecce':'Patio of the villa with a garden in Lecce'} width="1050" height="1400" loading="lazy" data-source="client" data-subject="Villa patio Lecce"/></figure></div>
  </div></section>
</Layout>
